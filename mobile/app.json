{
  "expo": {
    "name": "Bankiko",
    "slug": "bankiko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.cliffgor.bankiko",
      "associatedDomains": [
        "applinks:bankiko.app",
        "applinks:bankiko.onrender.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16a34a"
      },
      "package": "ke.cliffgor.bankiko",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bankiko.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "bankiko.onrender.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Bankiko needs access to your contacts to invite members to groups."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16a34a",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "scheme": "bankiko",
    "extra": {
      "apiUrl": "https://bankiko.onrender.com"
    }
  }
}
