# Copy this file to .env and fill in the values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/bankiko
DB_USERNAME=bankiko
DB_PASSWORD=bankiko_secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret-at-least-32-chars

# ── Fineract ──────────────────────────────────────────────────────────────────
FINERACT_BASE_URL=http://localhost:8443/fineract-provider/api/v1
FINERACT_TENANT=default
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password

# ── M-Pesa Daraja (https://developer.safaricom.co.ke) ─────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey

# Public URLs Safaricom will POST callbacks to — use ngrok for local dev:
#   ngrok http 8080  →  copy the https URL as the base
MPESA_STK_CALLBACK_URL=https://your-ngrok-url/api/mpesa/callback/stk
MPESA_B2C_CALLBACK_URL=https://your-ngrok-url/api/mpesa/callback/b2c
MPESA_B2C_TIMEOUT_URL=https://your-ngrok-url/api/mpesa/callback/b2c/timeout

# B2C — from your Daraja app's B2C credentials section
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_SECURITY_CREDENTIAL=your_b2c_security_credential

# ── Africa's Talking (https://africastalking.com) ─────────────────────────────
AT_API_KEY=your_at_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=BANKIKO
