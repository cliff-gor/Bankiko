# Copy this file to .env and fill in the values
# Never commit .env to git

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-secret

# M-Pesa Daraja (https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback/stk
MPESA_B2C_INITIATOR_NAME=testapi
MPESA_B2C_SECURITY_CREDENTIAL=your_security_credential

# Africa's Talking (https://africastalking.com)
AT_API_KEY=your_at_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=BANKIKO
